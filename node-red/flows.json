    {
        "id": "51a203e45d7b5ef5",
        "type": "function",
        "z": "8affa9461d5b2769",
        "g": "c313a9d86301458b",
        "name": "tempValue",
        "func": "const tempValue = parseFloat(msg.payload);\n\nif (isNaN(tempValue)) {\n    // If fail, send error or set null\n    msg.payload = { \n        temperature: null, \n        timestamp: new Date(),\n        error: \"Input is not a valid number\"\n    };\n} else {\n    msg.payload = { \n        temperature: tempValue, \n        timestamp: new Date() \n    };\n}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
